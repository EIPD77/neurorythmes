---
layout: base.njk
title: "Home"
---
<h1>{{ site.name }}</h1>
<p>{{ site.description }}</p>

<h2>Latest articles</h2>
<ul>
{% for post in collections.posts | reverse %}
  <li>
    <a href="{{ post.url }}">{{ post.data.title }}</a>
    <span class="meta">— {{ post.date | readableDate }}</span>
  </li>
{% endfor %}
</ul>