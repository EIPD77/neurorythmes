---
layout: base.njk
---
<article>
  {% include "partials/header.njk" %}

  {{ content | safe }}

  {% if tags %}
    <footer class="tags">
      <h2 class="sr-only">Tags</h2>
      <ul>
        {% for tag in tags %}
          <li><a href="/tags/{{ tag | slug }}/">{{ tag }}</a></li>
        {% endfor %}
      </ul>
    </footer>
  {% endif %}
</article>